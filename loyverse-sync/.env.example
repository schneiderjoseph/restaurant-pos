# Loyverse → POSR sync. Copy to loyverse-sync/.env — never commit secrets.
#
# CRITICAL: use an ISOLATED Surreal namespace/database — never the ASI/native posr/posr.
# Bootstrap once: npm run bootstrap-db
# Worktree only: C:\CODE\restaurant-pos-loyverse

# --- Loyverse API (Personal Access Token from Back Office) ---
LOYVERSE_ACCESS_TOKEN=
LOYVERSE_API_BASE=https://api.loyverse.com/v1.0
# LOYVERSE_STORE_ID=

# Mirror + projection flags
LOYVERSE_MIRROR_SYNC=1
LOYVERSE_MENU_SYNC=1
LOYVERSE_CUSTOMER_SYNC=1
LOYVERSE_PAYMENT_SYNC=1
LOYVERSE_DISCOUNT_SYNC=1
LOYVERSE_MODIFIER_SYNC=1
LOYVERSE_SYNC_INVENTORY=0
LOYVERSE_SYNC_RECEIPTS=0
LOYVERSE_SYNC_SHIFTS=0
LOYVERSE_SYNC_SUPPLIERS=1
LOYVERSE_SYNC_POS_DEVICES=1
LOYVERSE_SYNC_MERCHANT=1
LOYVERSE_RECEIPTS_BACKFILL=0
LOYVERSE_PROJECT_RECEIPTS=0
LOYVERSE_RATE_LIMIT_RPM=50

# --- Isolated SurrealDB (NOT posr/posr) ---
SURREAL_URL=ws://127.0.0.1:8001/rpc
LOYVERSE_SURREAL_NS=loyverse
LOYVERSE_SURREAL_DB=loyverse
SURREAL_USER=posr
SURREAL_PASS=posr-local-dev-change-me

LOYVERSE_SYNC_INTERVAL_MS=60000
LOYVERSE_SYNC_ONCE=0

# Webhooks (optional, port 3150)
# LOYVERSE_WEBHOOK_PORT=3150
# LOYVERSE_WEBHOOK_SECRET=
