# ASI → POSR sync (read-only). Copy to asi-sync/.env — never commit secrets.
#
# CRITICAL (restaurant-pos native):
# - SURREAL_URL must be THIS repo's Surreal only (do not reuse a fork ASI DB).
# - ASI_MENU_SYNC and ASI_FD_SYNC default OFF here — enable only when intentional.
# - Do not run this poller unless you mean to write into your local Surreal.

# --- Menu: ASI SQL (ASIPOS600 on PMS_HOST / ASI2017) ---
ASI_SQL_SERVER=192.168.0.190
ASI_SQL_PORT=56479
ASI_SQL_DATABASE=ASIPOS600
ASI_SQL_USER=posr_sync
ASI_SQL_PASSWORD=
ASI_SQL_ENCRYPT=false
ASI_SQL_TRUST_CERT=true
ASI_MENU_SYNC=0
# Dining tables (mTable → floor_table). Empty = follow ASI_MENU_SYNC.
# ASI_TABLE_SYNC=1

# --- FrontDesk guests (ASIFD600) — mapping: fCheckInInfo + cUnit.unitAlias ---
# Off by default. Set ASI_FD_SYNC=1 + credentials only when syncing into THIS Surreal.
ASI_FD_SYNC=0
# Hotel rooms (cUnit → floor Chambres). Empty = follow ASI_FD_SYNC.
# ASI_ROOM_SYNC=1
ASI_FD_SQL_SERVER=192.168.0.190
ASI_FD_SQL_PORT=56479
ASI_FD_SQL_DATABASE=ASIFD600
ASI_FD_SQL_USER=posr_fd_sync
ASI_FD_SQL_PASSWORD=
ASI_FD_SQL_ENCRYPT=false
ASI_FD_SQL_TRUST_CERT=true

# --- POSR SurrealDB (this checkout only) ---
SURREAL_URL=ws://127.0.0.1:8002/rpc
SURREAL_NS=posr
SURREAL_DB=posr
SURREAL_USER=posr
SURREAL_PASS=posr-local-dev-change-me

ASI_SYNC_INTERVAL_MS=30000
ASI_SYNC_ONCE=0
ASI_PRICE_TO_HTG=0
# Optional: only sync one ASI posID (outlet). Empty = all outlets (best rate wins).
# Example: posID 2 ≈ largest live catalog (confirm per property).
# ASI_POS_ID=2
