# Isolated Loyverse gateway template — copy to gateway/.env.loyverse locally (gitignored).
# Used by start-demo-ui.js / worktree. NEVER overwrite ASI gateway/.env (:3142).

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3143
GATEWAY_JWT_SECRET=change-me-same-as-root-env
GATEWAY_JWT_TTL=12h
GATEWAY_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
GATEWAY_ALLOW_LAN=true

SURREAL_URL=ws://127.0.0.1:8001/rpc
SURREAL_NS=loyverse
SURREAL_DB=loyverse
SURREAL_USER=posr
SURREAL_PASS=posr-local-dev-change-me
SURREAL_CONNECT_TIMEOUT_MS=10000
